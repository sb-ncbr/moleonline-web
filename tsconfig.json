{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "sourceMap": true,
    "rootDir": "./sources",
    "outDir": "./dist"
  },
  "include": ["sources/src/**/*"]
}

